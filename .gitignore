node_modules/
dist/
dist-ssr/
*.local
.DS_Store

# Environment — never commit real keys
.env
.env.*
# Exception: production build config. Holds ONLY the project URL and the
# publishable key, both of which are public by design - they are compiled
# into the JavaScript bundle and readable by anyone using the app. Row-level
# security is what protects the data, not secrecy of this key. Committing it
# means every device opens straight at the login screen instead of asking
# each visitor to paste connection details.
!.env.production
!.env.example

# Supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# Build / test artefacts
coverage/
playwright-report/
test-results/
.vite/
*.tsbuildinfo

# Throwaway Postgres cluster created by `npm run db:test`
scripts/db-test/.pgdata/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# Sample PDF produced by npm run pdf:test
scripts/pdf-test/*.pdf

# Local dev server logs
dev-server.log
dev-server.err.log

# Generated setup PDF (contains project ref and local IP)
Perfect-Optical-Vision-Setup-Queries.pdf

# Generated logo/screen previews
scripts/theme/preview/
