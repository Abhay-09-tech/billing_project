# ─────────────────────────────────────────────────────────────────────────────
# Frontend — these values are BUNDLED INTO THE BROWSER.
# Only ever put the anon/publishable key here. It is safe to expose ONLY because
# every table is protected by Row Level Security.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: shown in the UI so staff can tell dev from production at a glance.
VITE_APP_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# NEVER put the following in this file or in any VITE_* variable.
# They belong in Supabase Edge Function secrets only:
#   supabase secrets set WHATSAPP_ACCESS_TOKEN=...
#
#   SUPABASE_SERVICE_ROLE_KEY   full database access, bypasses RLS
#   WHATSAPP_ACCESS_TOKEN       Meta Cloud API permanent token
#   WHATSAPP_PHONE_NUMBER_ID    Meta phone number id
#   WHATSAPP_WABA_ID            WhatsApp Business Account id
#   WHATSAPP_VERIFY_TOKEN       webhook handshake secret
#   WHATSAPP_APP_SECRET         used to verify X-Hub-Signature-256
# ─────────────────────────────────────────────────────────────────────────────
